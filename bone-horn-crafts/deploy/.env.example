# Copy to deploy/.env and fill in. Never commit the real file.
#
#   cp deploy/.env.example deploy/.env
#   docker compose -f deploy/docker-compose.yml up -d

DB_NAME=bhc
DB_USER=bhc
DB_PASSWORD=change-me-to-something-long
DB_ROOT_PASSWORD=change-me-too

# Used as the object cache key prefix, so two installs can share one Redis.
SITE_HOST=bonehorncrafts.local

# 'development' makes the plugin rewrite absolute SEO URLs onto the canonical
# host, which is what you want anywhere that is not the real domain.
WP_ENV=development

HTTP_PORT=8080
