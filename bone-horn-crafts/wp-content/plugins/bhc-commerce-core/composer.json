{
	"name": "bonehorncrafts/bhc-commerce-core",
	"description": "Commerce core plugin for the Bone Horn Crafts WooCommerce store.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/php-compatibility": "^9.3",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"BoneHornCrafts\\Core\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"BoneHornCrafts\\Core\\Tests\\": "tests/"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs --standard=../../../phpcs.xml.dist",
		"lint:fix": "phpcbf --standard=../../../phpcs.xml.dist"
	}
}
